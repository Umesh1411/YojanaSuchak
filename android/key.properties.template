# Template for key.properties
# Copy this file to android/key.properties and fill in your values
# DO NOT commit key.properties to version control!

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=mahavoice
storeFile=C:/Users/YourUsername/mahavoice-key.jks

# Instructions:
# 1. Generate keystore: keytool -genkey -v -keystore mahavoice-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias mahavoice
# 2. Copy this template to android/key.properties
# 3. Replace all YOUR_* values with actual values
# 4. Update storeFile path to your actual keystore location










