rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Schemes - public read; anyone with Firebase auth can write (admin screen has hardcoded password guard)
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      // Owner can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // my_schemes subcollection
      match /my_schemes/{schemeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // notifications - owner reads, any authenticated user can write (admin notification sweep)
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null;
      }

      // legacy savedSchemes
      match /savedSchemes/{schemeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
